# Copy to .env and fill in the providers you want. The "fake" provider needs nothing.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Set to 1 if Ollama is running locally (ollama pull llama3.2)
OLLAMA_ENABLED=0

# Optional model overrides
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# GROQ_MODEL=openai/gpt-oss-20b
# OLLAMA_MODEL=llama3.2

# Optional: LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
